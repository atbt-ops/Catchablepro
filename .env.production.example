# Copy this file to .env.production. Never commit the completed file.
# This configuration serves actual users, so console email is deliberately not
# supported here. They need verification and password-recovery messages.

ENV=production
PUBLIC_URL=https://jobs.example.com
TRUSTED_HOSTS=jobs.example.com

# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-long-random-value

# Use one real provider. SMTP is shown; SendGrid's HTTPS API is also supported.
EMAIL_BACKEND=smtp
EMAIL_FROM="Catchablepro <no-reply@jobs.example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_TLS=true

# Optional. This protects the production /metrics endpoint if you enable a
# Prometheus scraper. Leave it blank when metrics are not in use.
METRICS_TOKEN=
