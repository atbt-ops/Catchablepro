# Copy to .env for local use, or set these as environment variables in your host.

# "production" enables Secure cookies and REQUIRES a real SECRET_KEY below.
# Leave unset (or "dev") for local development.
ENV=dev

# Signing key for session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when ENV=production — the app refuses to start with the dev default.
SECRET_KEY=dev-secret-change-me

# ---------------------------------------------------------------------------
# Email. "console" (default) sends nothing — messages are just logged, so you
# can never mail real candidates by accident. Switch to smtp or sendgrid to
# actually deliver.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@yourdomain.com

# --- Option A: SMTP (Gmail, SES, Mailgun, or SendGrid's relay) --------------
# SendGrid via SMTP: host=smtp.sendgrid.net, user=apikey, password=<API key>
#EMAIL_BACKEND=smtp
#SMTP_HOST=smtp.sendgrid.net
#SMTP_PORT=587
#SMTP_USER=apikey
#SMTP_PASSWORD=your-api-key
#SMTP_USE_TLS=true

# --- Option B: SendGrid HTTPS API (use if the host blocks SMTP ports) -------
#EMAIL_BACKEND=sendgrid
#SENDGRID_API_KEY=your-api-key

# ---------------------------------------------------------------------------
# AI features (optional). Powers the employer "AI assistant" (job description ->
# ranked candidates) and the admin feedback digest. They run against a local
# Ollama server you host — no API key, no per-call cost, no data leaves the box.
# Leave AI_MODEL unset to disable both (pages show a "not configured" notice).
#   1. Install Ollama (https://ollama.com), then: ollama pull qwen2.5:7b
#   2. Set AI_MODEL below to that tag.
# ---------------------------------------------------------------------------
#AI_MODEL=qwen2.5:7b
# Where Ollama listens. Default assumes it runs on the same machine as a plain
# `ollama serve`. From inside Docker use http://host.docker.internal:11434 and
# start Ollama with OLLAMA_HOST=0.0.0.0 so the container can reach it.
#OLLAMA_URL=http://127.0.0.1:11434
