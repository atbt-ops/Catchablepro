# Copy to .env for local use, or set these as environment variables in your host.

# "production" enables Secure cookies and REQUIRES a real SECRET_KEY below.
# Leave unset (or "dev") for local development.
ENV=dev

# Signing key for session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when ENV=production — the app refuses to start with the dev default.
SECRET_KEY=dev-secret-change-me
